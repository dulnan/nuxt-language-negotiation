{
  "name": "nuxt-language-negotiation",
  "version": "2.0.2",
  "description": "Simple language negotiation for Nuxt 3.",
  "license": "MIT",
  "repository": "github:dulnan/nuxt-language-negotiation",
  "keywords": [
    "nuxt",
    "language",
    "i18n",
    "multi-language",
    "translation",
    "internationalization"
  ],
  "author": {
    "name": "Jan Hug",
    "url": "https://dulnan.net",
    "email": "me@dulnan.net"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./server-options": "./dist/server-options.mjs",
    "./negotiators": "./dist/negotiators.mjs"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "server-options": [
        "./dist/server-options.d.mts"
      ],
      "negotiators": [
        "./dist/negotiators.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:serve": "node playground/.output/server/index.mjs",
    "dev:prepare": "PLAYGROUND_MODULE_BUILD=true nuxt-module-build build --stub && PLAYGROUND_MODULE_BUILD=true nuxt-module-build prepare && nuxi prepare playground",
    "generate": "nuxi generate",
    "typecheck": "npm run typecheck:build && npm run typecheck:runtime && npm run typecheck:server && npm run typecheck:playground",
    "typecheck:build": "vue-tsc --noEmit -p .nuxt/tsconfig.node.json",
    "typecheck:runtime": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "typecheck:server": "vue-tsc --noEmit -p .nuxt/tsconfig.server.json",
    "typecheck:playground": "vue-tsc --noEmit -p ./playground/.nuxt/tsconfig.app.json",
    "docs:dev": "vitepress dev docs --port 5000",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs --port 5000",
    "prettier": "prettier ./src --check",
    "prettier:fix": "prettier ./src --write",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "intl-parse-accept-language": "^1.0.0",
    "iso-639-1": "^3.1.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/kit": "^4.4.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@nuxt/test-utils": "^4.0.0",
    "@types/accept-language-parser": "^1.5.8",
    "@types/node": "^25.5.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "happy-dom": "~20.8",
    "nuxt": "^4.4.2",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  }
}
