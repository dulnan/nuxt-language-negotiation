{
  "name": "nuxt-language-negotiation",
  "version": "2.0.2",
  "description": "Simple language negotiation for Nuxt 3.",
  "repository": "github:dulnan/nuxt-language-negotiation",
  "keywords": [
    "nuxt",
    "language",
    "i18n",
    "multi-language",
    "translation",
    "internationalization"
  ],
  "author": {
    "name": "Jan Hug",
    "url": "https://dulnan.net",
    "email": "me@dulnan.net"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./server-options": "./dist/server-options.mjs",
    "./negotiators": "./dist/negotiators.mjs"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "server-options": [
        "./dist/server-options.d.mts"
      ],
      "negotiators": [
        "./dist/negotiators.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "PLAYGROUND_DEV=true nuxi dev playground",
    "dev:nitro3": "PLAYGROUND_NITRO=3 PLAYGROUND_DEV=true nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:serve": "node playground/.output/server/index.mjs",
    "dev:prepare": "PLAYGROUND_MODULE_BUILD=true nuxt-module-build build --stub && PLAYGROUND_MODULE_BUILD=true nuxt-module-build prepare && nuxi prepare playground",
    "generate": "nuxi generate",
    "typecheck": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "prettier": "prettier ./src ./test --check",
    "prettier:fix": "prettier ./src ./test --write",
    "lint": "eslint ./src ./test",
    "lint:fix": "eslint ./src ./test --fix",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:e2e": "nuxt-module-build build && vitest run --project e2e",
    "test:watch": "vitest watch --project unit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.7.0",
    "cookie-es": "^3.1.1",
    "intl-parse-accept-language": "^1.0.0",
    "iso-639-1": "^3.1.7"
  },
  "devDependencies": {
    "@nuxt/cli": "^4.1.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.7.0",
    "@nuxt/test-utils": "^4.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-prettier": "^5.5.7",
    "h3": "^1.15.11",
    "nitro": "^3.0.261103-rc",
    "nuxt": "^4.7.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  }
}
